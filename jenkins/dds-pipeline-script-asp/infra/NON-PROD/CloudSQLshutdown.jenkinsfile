@Library('dsx_gcp_shared_libraries@infra-spec')_
properties(
    buildDiscarder(logRotator(numToKeepStr:"10")),
    pipelineTriggers {
        parameterizedCron('''
                0 16 * * % ENVIRONMENT_NAME=dev;BUSINESS_REGION=ASP;STATUS=DOWN;
        ''')
    },
    parameters(
        choice(name: "ENVIRONMENT_NAME", choices: ["dev","sit","UAT","preprod"], description: ""),
        choice(name: "BUSINESS_REGION", choices: ["ASP", "GB", "MENA", "Core", "East ASP"], description: "Business region given configuration work for"),
        choice(name: "STATUS", choices: ["DOWN", "UP"], description: "Should the SQL instance be shutdown or started up"),
    )
)

static final String C_CONFIG_ID = "${env.BUILD_TAG}.toLowerCase().replace('jenkins-', '').replace('_', '-').replace(' ', '-')"
static final String C_CONFIG_YML_FILE = "${params.ENVIRONMENT_NAME.toLowerCase()}.yml"
def sourceContent = libraryResource "dsx/${params.BUSINESS_REGION.toLowerCase()}/${C_CONFIG_YML_FILE}"
def C_MY_OBJECT = readYaml text: "${sourceContent}"

pipeline {
    agent {
        node { label 'cm-linux' }
    }

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        GOOGLE_APPLICATION_CREDENTIALS = "$env.WORKSPACE/target_key.json"
        NO_PROXY                       = "127.0.0.1,localhost,hsbc"
    }

    stages {
        stage('Environment Init') {
            steps{
                script {
                    // via terraform key to connect with gcp project
                    key = "terraform-sa-${ENVIRONMENT_NAME.toLowerCase()}-${BUSINESS_REGION.toLowerCase()}"
                    echo "Using key: ${key} to connect to GCP project: ${C_MY_OBJECT.global.project_id}"

                    withCredentials([file(credentialsId: key, variable: 'GCP_KEY')]){
                        sh(script: 'cat ${GCP_KEY} > ./target_key.json', returnStdout: false)
                        sh(returnStdout: true, script: 'gcloud config configurations create cloudsqlshutdown-${C_CONFIG_ID}')
                        sh(returnStdout: true, script: 'gcloud config set proxy/type http_no_tunnel')
                        sh(returnStdout: true, script: "gcloud config set proxy/address ${C_MY_OBJECT.global.gcp_proxy}")
                        sh(returnStdout: true, script: "gcloud config set proxy/port 3128")
                        sh(returnStdout: true, script: "gcloud auth activate-service-account --key-file=target_key.json")
                        sh(script: "gcloud config set project '${C_MY_OBJECT.global.project_id}' --configuration='cloudsqlshutdown-${C_CONFIG_ID}'", returnStdout: false)
                    }
                }
            }
        }

        stage('Shutdown SQL instance') {
            environment {
                HTTPS_PROXY="${C_MY_OBJECT.global.gcp_proxy}:3128"
            }
            when {
                expression { return params.STATUS == 'DOWN' }
            }
            steps {
                script {
                    def projectId = C_MY_OBJECT.global.project_id
                    def instanceList = sh(script: "gcloud sql instances list --project=${projectId} --format='value(name)'", returnStdout: true).trim().split('\n')

                    for (def instanceName : instanceList) {
                        def state = sh(script: "gcloud sql instances describe ${instanceName} --project=${projectId} --format='value(state)'", returnStdout: true).trim()
                        if (state == 'STOPPED') {
                            print("The Cloud SQL instance ${instanceName} is already stopped.")
                        } else {
                            sh(returnStdout: true, script: "gcloud sql instances patch ${instanceName} --activation-policy NEVER --project ${projectId} --async")
                            print("Cloud SQL instance ${instanceName} will be stopped in a few minutes.")
                        }
                    }
                }
            }
        }

        stage('Startup SQL instance') {
            environment {
                HTTPS_PROXY="${C_MY_OBJECT.global.gcp_proxy}:3128"
            }
            when {
                expression { return params.STATUS == 'UP' }
            }
            steps {
                script {
                    def projectId = C_MY_OBJECT.global.project_id
                    def instanceList = sh(script: "gcloud sql instances list --project=${projectId} --format='value(name)'", returnStdout: true).trim().split('\n')
                    for (def instanceName : instanceList) {
                        def state = sh(script: "gcloud sql instances describe ${instanceName} --project=${projectId} --format='value(state)'", returnStdout: true).trim()
                        if (state == 'RUNNABLE') {
                            print("The Cloud SQL instance ${instanceName} is already running.")
                        } else {
                            // run the command asynchronously using the --async flag. This allows the command to return immediately, and the operation will continue in the background.
                            sh(returnStdout: true, script: "gcloud sql instances patch ${instanceName} --activation-policy ALWAYS --project ${projectId} --async")
                            print("Cloud SQL instance ${instanceName} will be started in a few minutes.")
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Jenkins SQL shutdown build: ${env.BUILD_URL} for GCP: ${C_MY_OBJECT.global.project_id} Failed."
        }
    }
}