[Unit]
Description=Airflow Triggerer daemon
After=network.target cloud-sql-proxy.service airflow-db-upgrade.service
Wants=cloud-sql-proxy.service airflow-db-upgrade.service
 
[Service]
Environment="AIRFLOW_HOME=/opt/airflow"
EnvironmentFile=/etc/sysconfig/airflow
User=root
Group=root
Type=simple
ExecStart=/bin/bash -ce "/usr/local/bin/airflow triggerer 2>&1 >> /var/log/triggerer.log"
Restart=always
RestartSec=5s
 
[Install]
WantedBy=multi-user.target