# 配置 GCP Provider
terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 4.51.0" # 使用较新版本以支持完整功能
    }
  }
}

provider "google" {
  project = "your-gcp-project-id" # 替换为你的 GCP 项目 ID
  region  = "us-central1"         # 替换为你的目标区域
}

# 创建 Cloud SQL 主从（高可用）实例
resource "google_sql_database_instance" "main" {
  name             = "cloudsql-ha-instance" # 实例名称
  region           = "us-central1"         # 实例区域
  database_version = "MYSQL_8.0"           # 数据库版本

  settings {
    tier = "db-custom-2-7680" # 机器规格，按需调整（如：db-f1-micro）

    # 高可用配置（主从/主备核心配置）
    availability_type = "REGIONAL" # 设置为 REGIONAL 即为主从（跨可用区）高可用

    # 存储配置
    disk_type = "PD_SSD"  # 磁盘类型
    disk_size = 100       # 磁盘大小（GB）

    # IP 配置（按需选择公网或私网）
    ip_configuration {
      ipv4_enabled = true # 开启公网访问
      authorized_networks {
        name  = "all"
        value = "0.0.0.0/0" # 允许所有 IP 访问（生产环境建议限制为特定 IP）
      }
      # 若使用私网，请注释 ipv4_enabled 并配置 private_network
      # ipv4_enabled = false
      # private_network = "projects/your-project-id/global/networks/your-vpc-network"
    }

    # 数据库参数配置（可选）
    database_flags {
      name  = "max_connections"
      value = "100"
    }
  }

  # 主实例密码（通过 random_password 生成或明文设置）
  root_password = "your-secure-password" # 替换为你的数据库 root 密码

  deletion_protection = false # 生产环境建议设置为 true，防止误删
}

# 可选：创建数据库
resource "google_sql_database" "database" {
  name     = "app_db"
  instance = google_sql_database_instance.main.name
}

# 可选：创建数据库用户
resource "google_sql_user" "user" {
  name     = "app_user"
  instance = google_sql_database_instance.main.name
  password = "user-password" # 替换为你的用户密码
}




