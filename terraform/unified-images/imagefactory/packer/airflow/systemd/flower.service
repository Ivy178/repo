[Unit]
Description=Airflow Celery Flower UI
After=network-online.target NetworkManager.service env-configure.service cloud-sql-proxy.service airflow-scheduler.service celery-worker.service
 
[Service]
Environment="AIRFLOW_HOME=/opt/airflow"
EnvironmentFile=/etc/sysconfig/airflow
User=root
Group=root
Type=simple
ExecStart=/bin/bash -ce "/usr/local/bin/airflow celery flower 2>&1 >> /var/log/flower.log"
Restart=always
RestartSec=5s
 
[Install]
WantedBy=multi-user.target