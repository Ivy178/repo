[Unit]
Description=Cloud Sql Proxy Daemon
After=network-online.target NetworkManager.service env-configure.service cloud-sql-multinic-route.service
Requires=cloud-sql-multinic-route.service
 
[Service]
User=root
Group=root
Type=simple
ExecStartPre=chmod +x /usr/local/sbin/cloud-sql-proxy.sh
ExecStart=/bin/bash /usr/local/sbin/cloud-sql-proxy.sh
Restart=on-failure
RestartSec=5s
PrivateTmp=true
 
[Install]
WantedBy=multi-user.target