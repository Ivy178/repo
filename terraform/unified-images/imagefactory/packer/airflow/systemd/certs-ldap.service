[Unit]
Description=Copy dag files from release bucket
After=network-online.target NetworkManager.service env-configure.service cloud-sql-proxy.service
 
[Service]
User=root
Group=root
Type=simple
ExecStart=/bin/bash /usr/local/sbin/airflow-ldap-certs.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=airflow-ldap-certs.sh
Restart=on-failure
RestartSec=5s
PrivateTmp=true
 
[Install]
WantedBy=multi-user.target