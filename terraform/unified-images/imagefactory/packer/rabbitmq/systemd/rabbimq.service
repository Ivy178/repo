[Unit]
Description=Configure rabbitMQ Server
After=network-online.target NetworkManager.service google-instance-setup.service env-configure.service
Requires=env-configure.service

[Service]
User=root
Group=root
Type=oneshot
ExecStartPre=chmod +x /usr/local/sbin/rabbitmq.sh
ExecStart=/bin/bash /usr/local/sbin/rabbitmq.sh
RemainAfterExit=true
Restart=on-failure
RestartSec=5s
PrivateTmp=true

[Install]
WantedBy=multi-user.target