[Unit]
Description=Celery delete-node script
After=network-online.target NetworkManager.service env-configure.service rabbitmq.service clustering.service
Requires=clustering.service

[Service]
User=root
Group=root
Type=simple
ExecStartPre=chmod +x /usr/local/sbin/delete-node.sh
ExecStart=/bin/bash /usr/local/sbin/delete-node.sh
Restart=always
RestartSec=300s

[Install]
WantedBy=multi-user.target