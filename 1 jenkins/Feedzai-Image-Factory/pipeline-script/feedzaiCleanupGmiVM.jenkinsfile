properties([
    buildDiscarder(logRotator(numToKeepStr:'60')),
    pipelineTriggers([
        parameterizedCron('''
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=APST;GCP_PROJECT=hsbc-12738076-feedzaistqa-dev;ZONE=asia-east2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=DEV;BUSINESS_REGION=AP;GCP_PROJECT=hsbc-11941970-feedzaiapqa-dev;ZONE=asia-east2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=US;GCP_PROJECT=hsbc-11941970-feedzaiapp-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=INDIA;GCP_PROJECT=hsbc-12692643-fdzindiaqa-dev;ZONE=asia-south1-a;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=HSBCNET;GCP_PROJECT=hsbc-12684830-fhsbcnetqa-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=EMEA;GCP_PROJECT=hsbc-12684817-fdzemeaqa-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=DEV;BUSINESS_REGION=UK;GCP_PROJECT=hsbc-11616597-fedzaieua-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=UK;GCP_PROJECT=hsbc-11616597-fedzaieua-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=HASE;GCP_PROJECT=hsbc-11941970-feedzaiapp-dev;ZONE=asia-east2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=DEV;BUSINESS_REGION=APM;GCP_PROJECT=hsbc-11412834-fdzmmqa-dev;ZONE=asia-east2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=DEV;BUSINESS_REGION=US;GCP_PROJECT=hsbc-20118033-feedzaisqa-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=MX;GCP_PROJECT=hsbc-20118034-feedzaismqa-dev;ZONE=europe-west2-b;
                0 22,0,2 * * * % ENVIRONMENT_NAME=DEV;BUSINESS_REGION=INDIA-RMA;GCP_PROJECT=hsbc-20118000-feedzalmqa-dev;ZONE=asia-south1-a;
                0 22,0,2 * * * % ENVIRONMENT_NAME=QA;BUSINESS_REGION=INDIA-RMA;GCP_PROJECT=hsbc-20118000-fdzrmaqa-dev;ZONE=asia-south1-a;
''')
    ]),
    parameters([
        choice(name: "ENVIRONMENT_NAME", choices: ["DEV", "QA"], description: ""),
        choice(name: "ZONE", choices: ["asia-east2-b", "europe-west2-b","asia-south1-a"], description: "your vm running zone"),
        choice(name: "BUSINESS_REGION", choices: ["AP", "UK", "HASE", "APST", "INDIA", "EMEA", "HSBCNET","APM","US", "MX", "INDIA-RMA"], description: "Business region given configuration work for"),
        string(name: 'GCP_PROJECT', defaultValue: '', description: 'GCP project id where vm are running') // Later think how to derive from previous 2
    ])
])

def build_id = "${env.BUILD_TAG}".toLowerCase().replace("jenkins-", "").replace("_", "-").replace(" ", "-")
def vmList
def longRunningVMs

pipeline {
    agent {
        node { label 'cm-linux' }
    }
    environment {
        GOOGLE_APPLICATION_CREDENTIALS = "$env.WORKSPACE/target_key.json"
        NO_PROXY                       = '127.0.0.1,localhost,.hsbc'
        NEXUS_302_CREDS                = credentials('NEXUS302_SA_TOKEN')
        GCP_PROXY                      = 'googleapis-dev.gcp.cloud.hsbc'
    }
    options {
        timeout(time: 1, unit: 'HOURS')
    }
    stages {
        stage('Environment Init') {
            steps {
                script {
                    // via terraform key to connect with gcp project
                    key = "terraform-deployer-${ENVIRONMENT_NAME.toLowerCase()}-${BUSINESS_REGION.toLowerCase()}"
                    echo "Using key: ${key} to connect to GCP project: ${params.GCP_PROJECT}"

                    withCredentials([file(credentialsId: key, variable: 'GCP_KEY')]){
                        sh(script: 'cat ${GCP_KEY} > ./target_key.json', returnStdout: false)
                        sh(returnStdout: true, script: "gcloud config configurations create ${build_id}")
                        sh(returnStdout: true, script: "gcloud config set proxy/type http_no_tunnel")
                        sh(returnStdout: true, script: "gcloud config set proxy/address ${GCP_PROXY}")
                        sh(returnStdout: true, script: "gcloud config set proxy/port 3128")
                        sh(returnStdout: true, script: "gcloud auth activate-service-account --key-file=target_key.json")
                        if (!params.GCP_PROJECT?.trim()) {
                            error "GCP_PROJECT parameter is required"
                        }
                        sh(script: "gcloud config set project '${params.GCP_PROJECT}' --configuration='${build_id}'", returnStdout: false)
                    }

                    wrap($class: 'BuildUser') {
                        def builder = env.BUILD_USER ?: env.BUILD_USER_ID ?: 'CICD Build'
                        addBadge(text: "Build by - ${builder}", cssClass: 'badge-text-background jenkins-!-color-purple')
                        addBadge(text: "Env - ${params.ENVIRONMENT_NAME}", cssClass: 'badge-text-background jenkins-!-color-teal')
                        addBadge(text: "Region - ${params.BUSINESS_REGION}", cssClass: 'badge-text-background jenkins-!-color-indigo')
                        addBadge(text: "Porject - ${params.GCP_PROJECT}", cssClass: 'badge-text-background jenkins-!-color-orange')
                    }
                }
            }
        }

        stage('Check/Delete gmitest VM') {
            steps {
                script {
                    // find running vm which with gmitest suffix and shutdown
                    // get VM name and zone (zone basename) as CSV, then build a list of maps [name:..., zone:...]
                    def vmListCsv = sh(
                        script: "gcloud compute instances list --project=${params.GCP_PROJECT} --filter='~name~gmitest\\' OR name~'packer-' OR name~'tmp-' --format=\"csv[no-heading](name,zone.basename())\"",
                        returnStdout: true
                    ).trim()

                    if (!vmListCsv) {
                        vmList = []
                        echo "No gmitest VMs found in project: ${params.GCP_PROJECT}"
                    } else {
                        vmList = vmListCsv.readLines().collect { line ->
                            def parts = line.split(',', 2)
                            def name = parts[0]?.trim()
                            def zone = (parts.length > 1) ? parts[1]?.trim() : params.ZONE
                            [name: name, zone: zone]
                        }
                    }
                    echo "Found gmitest VMs: ${vmList.collect { it.name + ' (' + it.zone + ')' }.join(', ')}"

                    longRunningVMs = []

                    for (vm in (vmList ?: [])) {
                        def vmName = vm?.name
                        def zone = vm?.zone ?: params.ZONE
                        if (!vmName) { continue } // Skip empty entries

                        def uptime = sh(
                            script: "gcloud compute instances describe ${vmName} --project='${params.GCP_PROJECT}' --zone='${zone}' --format='value(creationTimestamp)'",
                            returnStdout: true
                        ).trim()

                        if (uptime) {
                            def creationTime = java.time.Instant.parse(uptime).toEpochMilli()
                            def currentTime = java.time.Instant.now().toEpochMilli()
                            def duration = currentTime - creationTime
                            // If the VM has been running for more than 6 hours, add it to the list,算毫秒
                            if (duration > 6 * 60 * 60 * 1000) {
                                longRunningVMs << vmName
                            }
                        }
                    }

                    if (longRunningVMs) {
                        //echo "Found running Gmi test VMs: ${vmList}"
                        for (vmName in longRunningVMs) {
                            // find the matching entry from vmList to get the zone produced earlier
                            def entry = (vmList ?: []).find { it?.name == vmName }
                            def zoneToUse = entry?.zone ?: params.ZONE
                            echo "Deleting VM: ${vmName} in project: ${params.GCP_PROJECT} (zone: ${zoneToUse})"
                            sh(
                                script: "gcloud compute instances delete '${vmName}' --project='${params.GCP_PROJECT}' --zone='${zoneToUse}' --quiet",
                                returnStdout: false
                            )
                        }
                    } else {
                        echo "No running Gmi test VMs found."
                        longRunningVMs="No running Gmi test VMs longer than 4Hs found."
                    }
                }
            }
        }
    }
    post {
        cleanup {
            cleanWs()
        }
    }
}