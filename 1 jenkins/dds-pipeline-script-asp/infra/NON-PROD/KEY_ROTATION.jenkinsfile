@library('dds_gcp_shared_libraries@feature/infra-spec')_
import com.cloudbees.plugins.credentials.*;
import com.cloudbees.plugins.credentials.domains.Domain;
import org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl;
import com.cloudbees.hudson.plugins.folder.*;
import com.cloudbees.hudson.plugins.folder.properties.*;
import com.cloudbees.hudson.plugins.folder.properties.FolderCredentialsProvider.FolderCredentialsProperty;
import jenkins.model.Jenkins;

properties([
    buildDiscarder(logRotator(numToKeepStr:"10")),
    pipelineTriggers ([
        parameterizedCron('''
H 0 1 * * % ENVIRONMENT_NAME=dev;BUSINESS_REGION=asp;
H 0 1 * * % ENVIRONMENT_NAME=dev;BUSINESS_REGION=eu;
H 0 1 * * % ENVIRONMENT_NAME=uat;BUSINESS_REGION=asp;
H 0 1 * * % ENVIRONMENT_NAME=uat;BUSINESS_REGION=eu;
        ''')
    ]),
    parameters([
        choice(name: "ENVIRONMENT_NAME", choices: ["dev","uat"], description: ""),
        choice(name: "BUSINESS_REGION", choices: ["asp", "eu"], description: "Business region given configuration work for"),
    ])
])

static final String C_CONFIG_ID = "${env.BUILD_TAG}".toLowerCase().replace("jenkins-", "").replace("_", "-").replace(" ","-")
static final String C_CONFIG_YML_FILE = "${params.ENVIRONMENT_NAME.toLowerCase()}.yml"
def sourceContent = libraryResource "dds/${params.BUSINESS_REGION.toLowerCase()}/${C_CONFIG_YML_FILE}"
def C_MY_OBJECT = readYaml text: "${sourceContent}"

def sa_name = "dds-gce-infra-sa"
def jenkins_cred_id = "terraform-sa-${ENVIRONMENT_NAME.toLowerCase()}-${BUSINESS_REGION.toLowerCase()}"
def jenkins_cred_desc = "${jenkins_cred_id}"
def old_file_name = null

pipeline {
    agent {
        label "cm-linux-gce"
    }
    environment {
        GOOGLE_APPLICATION_CREDENTIALS = "$env.WORKSPACE/old-sa-key.json"
        NO_PROXY                   = "127.0.0.1,localhost,.hsbc"
    }
    stages {
        stage('Environment Init') {
            steps{
                script {
                    // via terraform key to connect with gcp project
                    key = "${jenkins_cred_id}"
                    echo "Using key: ${key} to connect to GCP project: ${C_MY_OBJECT.global.project_id}" //

                    withCredentials([file(credentialsId: key, variable: 'GCP_SA_KEY')]){
                        sh(script: 'cat ${GCP_SA_KEY} > ./old-sa-key.json', returnStdout: false)
                        sh(script: 'chmod 700 ./old-sa-key.json', returnStdout: false)
                        sh(returnStdout: true, script: "gcloud config configurations create keyrotation-${C_CONFIG_ID}")
                        sh(returnStdout: true, script: "gcloud config set proxy/type http_no_tunnel")
                        sh(returnStdout: true, script: "gcloud config set proxy/address ${C_MY_OBJECT.global.gcp_proxy}")
                        sh(returnStdout: true, script: "gcloud config set proxy/port 3128")
                        sh(returnStdout: true, script: "gcloud config activate-service-account --key-file=old-sa-key.json")
                        sh(script: "gcloud config set project '${C_MY_OBJECT.global.project_id}' --configuration='keyrotation-${C_CONFIG_ID}'", returnStdout: false)
                        old_file_name = sh(returnStdout: true, script: "basename ${GCP_SA_KEY}").trim()    //GCP_SA_KEY 指向的路径中取出文件名，并保存到 old_file_name
                    }
                }
            }
        }

        stage('rotate-gcp-sa-key') {
            steps {
                script {
                    Credentials old_creds
                    Credentials new_creds
                    def projectId = C_MY_OBJECT.global.project_id
                    def new_sa_key_file_name = "${sa_name}-" + sh(returnStdout: true, script: "date +\"%Y-%m-%dT%H:%M:%S\"").trim() + ".json"
                    def build_id = "keyrotation-${C_CONFIG_ID}"

                    sh(returnStdout: true, script: "gcloud iam service-accounts keys create ${new_sa_key_file_name} --iam-account ${sa_name}@${projectId}.iam.gserviceaccount.com --configuration ${build_id}")
                    echo "Successfully add new key to GCP!!"
                    def old_sa_key_json = readJSON file: "./old-sa-key.json"
                    def new_sa_key_json = readJSON file: "${new_sa_key_file_name}"

                    def old_sa_key = readFile file: "./old-sa-key.json"
                    def new_sa_key = readFile file: "${new_sa_key_file_name}"
                    def oldSecretBytes = SecretBytes.fromBytes(old_sa_key.getBytes())
                    def newSecretBytes = SecretBytes.fromBytes(new_sa_key.getBytes())

                    new_jenkins_cred_desc = jenkins_cred_desc + "-${new_sa_key_json.private_key_id}"

                    echo old_file_name

                    old_creds = new FileCredentialsImpl(CredentialsScope.GLOBAL, jenkins_cred_id, jenkins_cred_desc, old_file_name, oldSecretBytes)
                    new_creds = new FileCredentialsImpl(CredentialsScope.GLOBAL, jenkins_cred_id, new_jenkins_cred_desc, new_sa_key_file_name, newSecretBytes)

                    updateCreds(old_creds, new_creds)
                    sh(returnStdout: true, script: "gcloud iam service-accounts keys delete ${old_sa_key_json.private_key_id} --iam-account ${sa_name}@${projectId}.iam.gserviceaccount.com --configuration ${build_id}")
                    echo "Successfully rotated GCP SA key!!"
                }
            }
        }
    }
}

@NonCPS
def updateCreds(old_creds,new_creds) {
    def array = pwd().split("/")

    //need to use folder name hsbc-11374226-ccs-dds-eu as credential is under this folder
    // 从路径末尾往前数第四个部分，作为 folder_name。例如路径是 /.../hsbc-11374226-ccs-dds-eu/job/workspace，这里会取出 hsbc-11374226-ccs-dds-eu
    def folder_name = array[array.length - 4];
    print(folder_name)

    //The inclusion of this method throws serialization exceptions when @NonCPS is used
    // 按名称查找 Jenkins 中的项目或文件夹，并将结果存入 folder。后续代码可能会通过它访问该文件夹下的凭证或配置。
    def jenkins = Jenkins.instance     // 获取 Jenkins 实例
    def folder = jenkins.getItem(folder_name)
    // AbstractFolder<?> folderAbs = AbstractFolder.class.cast(folder)
    // property.getStore()：取得这个文件夹自己的凭证存储区。
    // updateCredentials(Domain.global(), old_creds, new_creds)：在该存储区的全局凭证域中找到 old_creds，并用 new_creds 更新它。
    AbstractFolder<?> folderAbs = folder as AbstractFolder<?>   // 把前面查到的 folder 转成 Jenkins 的文件夹类型，以便访问文件夹属性
    FolderCredentialsProperty property = folderAbs.getProperties().get(FolderCredentialsProperty.class)   //获取该文件夹的凭证属性
    //property.getStore().addCredentials(Domain.global(), new_creds)
    property.getStore().updateCredentials(Domain.global(), old_creds, new_creds)

    print("Successfully updated credential!!")
}